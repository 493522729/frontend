{
  "typescript.tsdk": "node_modules/typescript/lib",
  // 保存时跑 ESLint 的自动修复（perfectionist 排序、未用 import 删除等）
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  // 让 ESLint 接管这些语言的诊断；Vue 文件必须显式声明，否则 .vue 不进 lint
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  // 离线/内网环境无法访问 schemastore.org 时，禁止 IDE 联网拉取 JSON Schema，
  // 避免 package.json 等文件反复报 “Problems loading reference” 警告
  "json.schemaDownload.enable": false
}
