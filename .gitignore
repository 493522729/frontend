# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
memory
dist
dist-ssr
*.local

# 本地环境变量（.env.development / .env.production 要提交，*local 不提交）
.env.local
.env.*.local

# 测试与构建产物
coverage
stats.html

# AI 工具本地产物（CodeBuddy / WorkBuddy 的 agent 配置与会话文件，不入版本库）
.codebuddy
.codebuddy/
.workbuddy

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 临时文件
_tmp_*
*.tmp

# 截图等图片文件（不纳入版本控制，避免误提交）
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp

# 但 public/ 下的站点资源（favicon/logo/pwa/扫码图等）必须入库，否则部署 404
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.gif
!public/**/*.webp
!public/**/*.bmp
