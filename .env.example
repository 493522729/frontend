# 前端环境变量示例 —— 复制为 .env.development / .env.production 后按需修改
# 注意：所有变量必须以 VITE_ 开头才会被 Vite 注入到前端代码。

# 应用标题（写进 <title>）
VITE_APP_TITLE=简账

# dev server 端口
VITE_PORT=5173

# 接口前缀：所有请求以它开头，dev 下走 vite proxy
VITE_BASE_API=/api

# 后端 Spring Boot 地址（dev 下 vite proxy 转发目标）
VITE_PROXY_TARGET=http://localhost:8080

# 后端没起来时打开，前端可独立开发（mock 数据）
VITE_USE_MOCK=false

# 微信扫码登录：是否走真实后端链路
#   - false（默认）：前端用本地 mock 占位二维码，UI 流程跑通但不连真微信
#   - true：调真实后端 /api/auth/scan* 接口（后端须同时开启 app.wechat.enabled=true）
# 配合项目内 miniprogram/ 小程序工程一起使用（个人实名小程序 0 元方案）。
VITE_WECHAT_SCAN_ENABLED=false

# 构建体积分析（pnpm build:report 时会自动置 true）
VITE_REPORT=false
