# 应用标题（写进 <title>，通过 vite define 注入）
VITE_APP_TITLE=简账

# dev server
VITE_PORT=5173

# 接口前缀：所有请求以它开头，dev 下走 vite proxy
VITE_BASE_API=/api

# 后端 Spring Boot 地址（backend 还没初始化，起来后改这里）
VITE_PROXY_TARGET=http://localhost:8080

# 后端没起来时打开，前端可独立开发
VITE_USE_MOCK=false

# 微信扫码登录：是否走真实后端链路（true=调 /api/auth/scan* 真接口）
# 需后端同时开启 app.wechat.enabled=true 并配置 AppID/Secret。
# 已置 true：与后端启用真实微信小程序码链路。
VITE_WECHAT_SCAN_ENABLED=true

# 构建体积分析（pnpm build:report 时会自动置 true）
VITE_REPORT=false
